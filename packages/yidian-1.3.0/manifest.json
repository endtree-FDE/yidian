{
  "manifest_version": 3,
  "name": "一点｜收藏回看工具",
  "version": "1.3.0",
  "description": "第 1 天收下工作和学习中的重要内容，第 2、7、30 天再回来。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "alarms", "notifications", "scripting", "sidePanel", "storage"],
  "background": { "service_worker": "service-worker.mjs", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "打开一点｜收下或回看当前内容", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "web_accessible_resources": [{ "resources": ["fonts/ZCOOLXiaoWei-Regular.ttf"], "matches": ["<all_urls>"] }],
  "options_ui": { "page": "library.html", "open_in_tab": true },
  "commands": {
    "open-current-document": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "收下当前网页或选中的一段"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+Y", "mac": "MacCtrl+Shift+Y" },
      "description": "打开侧边栏，看看当前的收藏"
    }
  }
}
